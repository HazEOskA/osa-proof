FROM node:22-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    openssh-client \
    python3 \
    python3-pip \
    jq \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /workspace/project

WORKDIR /workspace

CMD ["sh", "-lc", "exec sleep infinity"]
