{
  "name": "osa-proof",
  "version": "0.1.0",
  "private": true,
  "description": "Proof-first backend for verifiable agentic systems.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "start": "node dist/apps/api/src/server.js",
    "start:worker": "node dist/apps/worker/src/server.js",
    "test:delivery-lab:browser": "npm run build && node scripts/test-delivery-lab.cjs",
    "test:platform:local": "npm run build && OSA_LOCAL_DOCKER_TEST=1 node --test dist/tests/platform-v05.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
